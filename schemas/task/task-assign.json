{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thalamus.dev/schemas/task/task-assign.json",
  "title": "Task Assign Event Payload",
  "type": "object",
  "required": [
    "task_id",
    "objective"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_output": {
      "type": "string"
    }
  },
  "additionalProperties": false
}